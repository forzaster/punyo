#!/usr/bin/env bash
# Shared: regenerate Punyo.xcodeproj if project.yml or Punyo/ changed
# between $1 (old ref) and $2 (new ref). No-op on same ref, on missing
# xcodegen, or when no watched paths differ.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

old="${1:-}"; new="${2:-HEAD}"
[ -n "$old" ] || exit 0
[ "$old" = "$new" ] && exit 0
# Newly-created refs (all-zeros) can't be diffed against.
case "$old" in *[!0]*) ;; *) exit 0 ;; esac

if git diff --quiet "$old" "$new" -- project.yml Punyo/ 2>/dev/null; then
    exit 0
fi

if ! command -v xcodegen >/dev/null 2>&1; then
    echo "note: project.yml or Punyo/ changed but xcodegen is not installed; skipping regeneration" >&2
    exit 0
fi

echo "post-hook: regenerating Punyo.xcodeproj (project.yml or Punyo/ changed)"
xcodegen generate --quiet
